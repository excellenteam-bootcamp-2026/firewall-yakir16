{
  "name": "firewall-orchestrator",
  "version": "1.0.0",
  "description": "HTTP orchestrator for firewall rules. Reads from Postgres, delegates writes to a Python worker over RabbitMQ.",
  "type": "module",
  "private": true,
  "license": "ISC",
  "scripts": {
    "start": "tsx src/main/server.ts",
    "dev": "tsx watch src/main/server.ts",
    "seed": "tsx scripts/mock_data_population.ts",
    "seed:fixtures": "tsx scripts/mock_data_population.ts --fixtures",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "typecheck": "tsc --noEmit",
    "db:pull": "drizzle-kit pull"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "tsx": "^4.23.4",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  }
}
