{
  "info": {
    "name": "Firewall orchestrator",
    "description": "One test per endpoint, plus the error paths that matter.\n\nRun the whole collection in order with the Collection Runner: the create requests save the ids that the update and delete requests use, and the last request removes everything this run created.\n\nValues are randomised per run from `runId`, so the collection can be run repeatedly without tripping the duplicate check.\n\nBoth services must be running: ./env-switch.sh dev",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// One run id for the whole collection, so every value is unique",
          "// to this run and the duplicate check is not tripped by a rerun.",
          "if (!pm.collectionVariables.get('runId')) {",
          "  const runId = Math.floor(Math.random() * 250) + 1;",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('ipA', `10.${runId}.1.1`);",
          "  pm.collectionVariables.set('ipB', `10.${runId}.1.2`);",
          "  pm.collectionVariables.set('domainA', `test-${runId}.example.com`);",
          "  pm.collectionVariables.set('portA', 20000 + runId);",
          "  pm.collectionVariables.set('portB', 30000 + runId);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness, and which environment the service resolved."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('reports ok', () => pm.expect(body.status).to.eql('ok'));",
                  "",
                  "pm.test('names the environment', () => {",
                  "  pm.expect(body.env).to.be.oneOf(['dev', 'production']);",
                  "});",
                  "",
                  "pm.collectionVariables.set('env', body.env);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Create rules",
      "item": [
        {
          "name": "POST /ips",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/ips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "ips"
              ]
            },
            "description": "Adds two IPv4 addresses to the blacklist.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": [\"{{ipA}}\", \"{{ipB}}\"],\n  \"mode\": \"blacklist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 201', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('echoes the type and mode', () => {",
                  "  pm.expect(body.type).to.eql('ip');",
                  "  pm.expect(body.mode).to.eql('blacklist');",
                  "  pm.expect(body.status).to.eql('success');",
                  "});",
                  "",
                  "pm.test('returns one entry per submitted value', () => {",
                  "  pm.expect(body.values).to.be.an('array').with.lengthOf(2);",
                  "});",
                  "",
                  "pm.test('every rule carries an id generated by the worker', () => {",
                  "  body.values.forEach((rule) => {",
                  "    pm.expect(rule.id).to.be.a('number');",
                  "    pm.expect(rule.active).to.eql(true);",
                  "  });",
                  "});",
                  "",
                  "// Kept for the update, delete and duplicate requests below.",
                  "pm.collectionVariables.set('ipIdA', body.values[0].id);",
                  "pm.collectionVariables.set('ipIdB', body.values[1].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /domains",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/domains",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "domains"
              ]
            },
            "description": "Adds a domain to the whitelist. Domains only, not URLs.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": [\"{{domainA}}\"],\n  \"mode\": \"whitelist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 201', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('echoes the type and mode', () => {",
                  "  pm.expect(body.type).to.eql('domain');",
                  "  pm.expect(body.mode).to.eql('whitelist');",
                  "});",
                  "",
                  "pm.test('stores the domain exactly as sent', () => {",
                  "  pm.expect(body.values[0].value).to.eql(pm.collectionVariables.get('domainA'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('domainId', body.values[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /ports",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/ports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "ports"
              ]
            },
            "description": "Adds two ports. Ports must be integers between 1 and 65535.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": [{{portA}}, {{portB}}],\n  \"mode\": \"blacklist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 201', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('echoes the type', () => pm.expect(body.type).to.eql('port'));",
                  "",
                  "// The column is varchar, so a port that came back as a string",
                  "// would mean the read path forgot to convert it.",
                  "pm.test('returns the port as a number, not a string', () => {",
                  "  pm.expect(body.values[0].value).to.be.a('number');",
                  "});",
                  "",
                  "pm.collectionVariables.set('portId', body.values[0].id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Read rules",
      "item": [
        {
          "name": "GET /rules",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/rules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "rules"
              ]
            },
            "description": "Every rule, grouped by type. This is the only route that reads Postgres directly."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns the three groups', () => {",
                  "  pm.expect(body).to.have.all.keys('ips', 'domains', 'ports');",
                  "});",
                  "",
                  "pm.test('contains the rules created by this run', () => {",
                  "  const ipId = String(pm.collectionVariables.get('ipIdA'));",
                  "  pm.expect(body.ips[ipId]).to.be.an('object');",
                  "  pm.expect(body.ips[ipId].value).to.eql(pm.collectionVariables.get('ipA'));",
                  "});",
                  "",
                  "pm.test('each rule has id, value and active', () => {",
                  "  const rule = body.ips[String(pm.collectionVariables.get('ipIdA'))];",
                  "  pm.expect(rule).to.have.all.keys('id', 'value', 'active');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /rules?type=ip",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/rules?type=ip",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "rules"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "ip"
                }
              ]
            },
            "description": "The same route filtered by type. The filter runs in SQL, not in memory."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('keeps the response shape', () => {",
                  "  pm.expect(body).to.have.all.keys('ips', 'domains', 'ports');",
                  "});",
                  "",
                  "pm.test('returns only ip rules', () => {",
                  "  pm.expect(Object.keys(body.domains)).to.have.lengthOf(0);",
                  "  pm.expect(Object.keys(body.ports)).to.have.lengthOf(0);",
                  "  pm.expect(Object.keys(body.ips).length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Update rules",
      "item": [
        {
          "name": "PATCH /rules/status \u2014 deactivate",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/rules/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "rules",
                "status"
              ]
            },
            "description": "Deactivates two rules of different types in one call.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [{{ipIdA}}, {{portId}}],\n  \"active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns the rules as they now stand', () => {",
                  "  pm.expect(body.updated).to.be.an('array').with.lengthOf(2);",
                  "  pm.expect(body.status).to.eql('success');",
                  "});",
                  "",
                  "pm.test('every returned rule is inactive', () => {",
                  "  body.updated.forEach((rule) => pm.expect(rule.active).to.eql(false));",
                  "});",
                  "",
                  "pm.test('the removed rules carry the full shape', () => {",
                  "  pm.expect(body.updated[0]).to.have.all.keys(",
                  "    'id', 'type', 'mode', 'value', 'active'",
                  "  );",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /rules \u2014 confirm the change persisted",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/rules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "rules"
              ]
            },
            "description": "Reads back from Postgres, so a worker that replied without writing would be caught here."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "const ipId = String(pm.collectionVariables.get('ipIdA'));",
                  "",
                  "pm.test('the stored rule really is inactive', () => {",
                  "  pm.expect(body.ips[ipId].active).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /rules/status \u2014 reactivate",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/rules/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "rules",
                "status"
              ]
            },
            "description": "Puts the two rules back, so the collection leaves no half-changed state.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [{{ipIdA}}, {{portId}}],\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('every returned rule is active again', () => {",
                  "  body.updated.forEach((rule) => pm.expect(rule.active).to.eql(true));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Rejected input",
      "item": [
        {
          "name": "POST /ips \u2014 invalid address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/ips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "ips"
              ]
            },
            "description": "Rejected by the domain before anything reaches the queue.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": [\"999.1.1.1\"],\n  \"mode\": \"blacklist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 400', () => pm.response.to.have.status(400));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('uses the documented error shape', () => {",
                  "  pm.expect(body).to.have.all.keys('status', 'code', 'message');",
                  "  pm.expect(body.status).to.eql('error');",
                  "});",
                  "",
                  "pm.test('reports INVALID_IP', () => pm.expect(body.code).to.eql('INVALID_IP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /ips \u2014 leading zeros",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/ips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "ips"
              ]
            },
            "description": "A subtler malformed address: each octet is in range, but the leading zero is not valid notation.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": [\"010.1.1.1\"],\n  \"mode\": \"blacklist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 400', () => pm.response.to.have.status(400));",
                  "pm.test('reports INVALID_IP', () => {",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_IP');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /ports \u2014 out of range",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/ports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "ports"
              ]
            },
            "description": "Ports must be integers between 1 and 65535.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": [70000],\n  \"mode\": \"blacklist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 400', () => pm.response.to.have.status(400));",
                  "pm.test('reports INVALID_PORT', () => {",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_PORT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /domains \u2014 a URL rather than a domain",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/domains",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "domains"
              ]
            },
            "description": "Domains must not include a protocol, path or port.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": [\"https://example.com/admin\"],\n  \"mode\": \"blacklist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 400', () => pm.response.to.have.status(400));",
                  "pm.test('reports INVALID_DOMAIN', () => {",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_DOMAIN');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /ips \u2014 empty values",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/ips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "ips"
              ]
            },
            "description": "Rejected by the request schema, before the domain is involved.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": [],\n  \"mode\": \"blacklist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 400', () => pm.response.to.have.status(400));",
                  "pm.test('reports VALIDATION_ERROR', () => {",
                  "  pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /ips \u2014 unknown mode",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/ips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "ips"
              ]
            },
            "description": "Mode must be strictly blacklist or whitelist.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": [\"8.8.4.4\"],\n  \"mode\": \"greylist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 400', () => pm.response.to.have.status(400));",
                  "pm.test('reports VALIDATION_ERROR', () => {",
                  "  pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /rules?type=banana",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/rules?type=banana",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "rules"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "banana"
                }
              ]
            },
            "description": "An unsupported filter is a client error, not an empty result."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 400', () => pm.response.to.have.status(400));",
                  "pm.test('reports INVALID_TYPE_FILTER', () => {",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_TYPE_FILTER');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /nope \u2014 unknown route",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/nope",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "nope"
              ]
            },
            "description": "An unmatched path still answers in the documented error shape."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 404', () => pm.response.to.have.status(404));",
                  "pm.test('reports NOT_FOUND', () => {",
                  "  pm.expect(pm.response.json().code).to.eql('NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Refused by the rule builder",
      "item": [
        {
          "name": "POST /ips \u2014 duplicate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/ips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "ips"
              ]
            },
            "description": "The same address created in step 1. Only the worker can see this, because only the worker reads the database before writing.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": [\"{{ipA}}\"],\n  \"mode\": \"blacklist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 409', () => pm.response.to.have.status(409));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('reports RULE_ALREADY_EXISTS', () => {",
                  "  pm.expect(body.code).to.eql('RULE_ALREADY_EXISTS');",
                  "});",
                  "",
                  "pm.test('explains which rule was refused', () => {",
                  "  pm.expect(body.message).to.include(pm.collectionVariables.get('ipA'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /ips \u2014 mode conflict",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/ips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "ips"
              ]
            },
            "description": "The address is already blacklisted, so whitelisting it would contradict an existing rule.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": [\"{{ipA}}\"],\n  \"mode\": \"whitelist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 409', () => pm.response.to.have.status(409));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('reports RULE_CONFLICT', () => {",
                  "  pm.expect(body.code).to.eql('RULE_CONFLICT');",
                  "});",
                  "",
                  "pm.test('names the mode it already belongs to', () => {",
                  "  pm.expect(body.message).to.include('blacklist');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /rules \u2014 unknown id",
