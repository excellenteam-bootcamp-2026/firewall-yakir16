    {
      "name": "6. Remove rules",
      "item": [
        {
          "name": "DELETE /rules",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/rules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "rules"
              ]
            },
            "description": "Removes everything this run created, so the collection can be run again immediately.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [{{ipIdA}}, {{ipIdB}}, {{domainId}}, {{portId}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns the rules as they were before deletion', () => {",
                  "  pm.expect(body.removed).to.be.an('array').with.lengthOf(4);",
                  "  pm.expect(body.status).to.eql('success');",
                  "});",
                  "",
                  "pm.test('each removed rule carries the full shape', () => {",
                  "  pm.expect(body.removed[0]).to.have.all.keys(",
                  "    'id', 'type', 'mode', 'value', 'active'",
                  "  );",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /rules \u2014 confirm they are gone",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/firewall/rules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firewall",
                "rules"
              ]
            },
            "description": "The deletion is only real if a fresh read no longer finds them."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('none of this run\\'s rules remain', () => {",
                  "  ['ipIdA', 'ipIdB'].forEach((key) => {",
                  "    pm.expect(body.ips[String(pm.collectionVariables.get(key))]).to.be.undefined;",
                  "  });",
                  "  pm.expect(body.domains[String(pm.collectionVariables.get('domainId'))]).to.be.undefined;",
                  "  pm.expect(body.ports[String(pm.collectionVariables.get('portId'))]).to.be.undefined;",
                  "});",
                  "",
                  "// A rerun should generate a fresh set of values.",
                  "pm.collectionVariables.unset('runId');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}