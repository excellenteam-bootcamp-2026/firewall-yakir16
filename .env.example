ENV=dev
LOG_LEVEL=DEBUG
DB_CONNECTION_INTERVAL=5000
RABBITMQ_HOST=your_host.rmq.cloudamqp.com
RABBITMQ_PORT=5671
RABBITMQ_USE_TLS=true
RABBITMQ_USERNAME=your_rabbitmq_user
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=your_rabbitmq_vhost
RABBITMQ_QUEUE=firewall-rules-queue-dev


DATABASE_HOST=aws-0-REGION.pooler.supabase.com
DATABASE_PORT=6543
DATABASE_USERNAME=postgres.PROJECT_REF
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=postgres

